# Copy to `.env` and adjust. Never commit `.env`.

# SQLite path for the pilot. Swap to a Postgres URL later.
DB_PATH=./data/legal_sourcing.sqlite

# Where scrapers dump immutable raw payloads.
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# Polite scraping defaults. Override per source if needed.
USER_AGENT=legal-sourcing-research/0.1 (+contact: you@example.com)
RATE_LIMIT_RPS=1.0
REQUEST_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
