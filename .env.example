# Copy to `.env` and adjust. Never commit `.env`.

# SQLite path for the pilot. Swap to a Postgres URL later.
DB_PATH=./data/legal_sourcing.sqlite

# Where scrapers dump immutable raw payloads.
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# Scraping defaults. These are GLOBAL FALLBACKS — each scraper is
# expected to override RPS and worker count based on the target
# server's capacity (declared in the scraper module; see
# docs/assumptions.md "Per-site worker pools and rate limits").
USER_AGENT=legal-sourcing-research/0.1
RATE_LIMIT_RPS=4.0
MAX_WORKERS=4
REQUEST_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# ---- Per-source secrets ------------------------------------------------
# AZ Bar API password (static UUID from the azbar.org JS bundle).
# Capture from DevTools per docs/data_sources/az_bar_reference.md.
# The value rotates occasionally; re-fetch when scraping starts failing
# with 401/403.
AZBAR_API_PASSWORD=
