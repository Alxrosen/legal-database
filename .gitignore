# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# uv
.uv-cache/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Environment
.env
.env.local

# Project data — never commit scraped content or local DBs
data/raw/
data/processed/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# Logs
logs/
*.log

# Notebooks (committed selectively — keep this strict for now)
notebooks/*
!notebooks/.gitkeep

# Canonization dry-run artifacts (regenerable; clusters.csv is ~450k rows)
data/dry_run/

# Surveyor QA: transient per-run artifacts (staged raw HTML + findings.json).
# The committed form of a bad case is the fixture under tests/fixtures/qa_cases/;
# the durable queues (data/qa/{to_review,rescrape_queue}.jsonl) stay tracked.
data/qa/*/
