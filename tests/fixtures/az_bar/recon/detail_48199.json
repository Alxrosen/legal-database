    "DisciplineHTML": "\r\n\r\n<script type=\"text/javascript\">\r\n    $(function () {\r\n        $(document).on('click', 'a.dispoSummary', function (event) {\r\n            event.preventDefault();\r\n            $(\"#dispoSummary_modal .modal-title\").html($(this).data(\"title\"));\r\n            $(\"#dispoSummary_modal .modal-body\").html($(this).data(\"body\"));\r\n            $(\"#dispoSummary_modal\").modal(\"show\");\r\n        });\r\n\r\n        $(document).on('click', '#lawyerHistory_btn', function (event) {\r\n            event.preventDefault();\r\n            $(\"#dispoSummary_modal .modal-title\").html(\"Request History Report for Anders Aannestad\");\r\n                \r\n                $(\"#dispoSummary_modal .modal-body\").html('<p>This individual has no public discipline record pursuant to Rule 70 Ariz. R. Sup. Ct.</p>');\r\n                \r\n            $(\"#dispoSummary_modal\").modal(\"show\");\r\n        });\r\n\r\n        $(document).tooltip({\r\n            content: function () {\r\n                return $(this).prop('title');\r\n            },\r\n            show: null,\r\n            close: function (event, ui) {\r\n                ui.tooltip.hover(\r\n\r\n                function () {\r\n                    $(this).stop(true).fadeTo(600, 1);\r\n                },\r\n\r\n                function () {\r\n                    $(this).fadeOut(\"600\", function () {\r\n                        $(this).remove();\r\n                    })\r\n                });\r\n            }\r\n        });\r\n    });\r\n</script>\r\n\r\n<style type=\"text/css\">\r\n    .modal-title {\r\n        width: 98%;\r\n        text-align: center;\r\n        display: inline-block;\r\n    }\r\n</style>\r\n\r\n    <h6>Discipline: None</h6>\r\n\r\n<div>\r\n    <p>\r\n        This website does not display all public sanctions or public information concerning a lawyer's disciplinary history. Obtain any additional public information by using the <a id=\"lawyerHistory_btn\" href=\"#\">history request form</a> to confirm the lawyer’s entire record.\r\n        <br />\r\n        <a target=\"_blank\" href=\"https://www.azbar.org/for-the-public/concerns-about-your-legal-professional/glossary-of-discipline-terms/\">Glossary of Terms</a>\r\n    </p>\r\n</div>\r\n\r\n\r\n<div id=\"dispoSummary_modal\" class=\"modal fade\" role=\"dialog\">\r\n    <div class=\"modal-dialog\">\r\n        <div class=\"modal-content\" style=\"border: 5px solid black;\">\r\n            <div class=\"modal-header alert-default\">\r\n                <h4 class=\"modal-title\"></h4>\r\n                <button type=\"button\" class=\"close\" onclick=\"$('#dispoSummary_modal').modal('hide');\">&times;</button>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                \r\n            </div>\r\n            <div class=\"modal-footer alert-default\">\r\n                <button type=\"button\" class=\"btn btn-default btn-sm\" onclick=\"$('#dispoSummary_modal').modal('hide');\">Close</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n",
